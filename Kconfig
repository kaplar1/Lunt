# Application Kconfig: our own build-time options. they appear in 
# menuconfig/guiconfig and can be set in prj.conf, an overlay .conf file
# or on the command line with -DCONFIG_<NAME>=<VALUE>

menu "LuntNode application"

config APP_SAMPLE_INTERVAL_SEC
    int "Seconds between sensor readings"
    default 10
    range 1 3600
    help
      The sensor thread sleeps this long between readings. Presssing 
      Button 0 triggers an immediate reading.

config APP_FAIL_SELFTEST
    bool "Deliberately fail the boot self-test (rollback demo)"
    help
      Build a version with this on, upload it as a TEST image, and watch 
      MCUboot revert to the previous version because the new image never 
      confirms itself.

config APP_BLE
	bool "Expose readings over the Bluetooth LE Environmental Sensing Service"
	depends on BT_PERIPHERAL
	help
	  Enabled by overlay-ble.conf.
    
config APP_SELFTEST_REBOOT_DELAY_SEC
    int "Seconds to wait before rebooting after a failed self-test"
    default 5
    help
      Only used when the running image is a test image that MCUboot will 
      revert on the next reboot.

# Creates CONFIG_APP_LOG_LEVEL and APP_LOG_LEVEL_{OFF,ERR,WRN,INF,DBG}
module = APP
module-str = LuntNode application
source "subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"